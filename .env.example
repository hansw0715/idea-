# 복사해서 .env.local 로 쓰세요. (.env.local 은 git에 안 올라감)
# 비워 두면 인메모리 저장소 + seed.json 으로 동작합니다.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 붙이지 말 것 (RLS를 무시하는 키)
SUPABASE_SERVICE_ROLE_KEY=

# 버스 위치를 보내는 기기(기사 폰/GPS 트래커)가 쓰는 토큰. 아무 긴 랜덤 문자열.
# 비워 두면 개발 모드에서만 토큰 없이 받아줍니다.
BUS_DEVICE_TOKEN=
