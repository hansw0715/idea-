# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)
#
# 값을 비워두면 로컬 PGlite(임베디드 Postgres)로 자동 실행되므로,
# Supabase에 붙여 볼 때만 채우면 됩니다.

# Supabase → Connect → Transaction pooler (포트 6543) 문자열을 그대로 붙여넣으세요.
# 비밀번호에 @ # ? / : 같은 문자가 있으면 URL 인코딩해야 합니다.
DATABASE_URL=

# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 로 생성
JWT_SECRET=

# 인증 메일 발송용 SMTP (없으면 로컬에서는 콘솔에 코드가 찍히고, 배포에서는 가입이 막힙니다)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# 빈 DB에 만들 운영 계정(admin1~3)의 비밀번호.
# 비워 두면 관리자 계정을 만들지 않습니다.
ADMIN_PASSWORD=
